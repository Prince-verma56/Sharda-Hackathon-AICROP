// Prisma Schema - Fullstack Hackathon Template
//
// This is the foundational schema. Domain-specific models
// (health, education, commerce) should be added when a specific
// problem statement requires them.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

/// Core user model. Extended by domain modules as needed.
model User {
  id              String     @id @default(cuid())
  /// Optional contact address only — never used to sign in (phone + OTP is the only login).
  email           String?    @unique
  /// Login identity: normalised E.164, e.g. +919876543210 (unique).
  phone           String?    @unique
  phoneVerifiedAt DateTime?
  name            String?
  avatarUrl       String?
  role            String     @default("user")
  status          UserStatus @default(ACTIVE)
  /// Last workspace chosen by a multi-role user ("farmer" | "volunteer" | "admin").
  activeWorkspace String?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  conversations Conversation[]
  memories      Memory[]
  documents     Document[]
  notifications Notification[]

  roles             UserRole[]          @relation("UserRoles")
  rolesGranted      UserRole[]          @relation("RoleGrantor")
  farmerProfile     FarmerProfile?
  volunteerProfile  VolunteerProfile?
  adminProfile      AdminProfile?
  farms             Farm[]
  diagnoses         Diagnosis[]
  feedback          DiagnosisFeedback[]
  expertReviews     ExpertReview[]      @relation("ReviewAuthor")
  knowledgeAuthored KnowledgeEntry[]    @relation("KnowledgeAuthor")
  knowledgeReviewed KnowledgeEntry[]    @relation("KnowledgeReviewer")
  invitationsSent   RoleInvitation[]    @relation("InvitationSender")
  sessions          Session[]

  @@index([createdAt])
  @@map("users")
}

/// Application sessions (phone OTP login). The cookie / Bearer token is random; only its SHA-256 is stored.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  /// "web" (HttpOnly cookie) or "mobile" (Bearer token for the Flutter app)
  client     String    @default("web")
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

// =============================================================================
// CropAI platform
// =============================================================================

/// Only ACTIVE accounts can sign in, even after a correct OTP.
enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DISABLED
}

/// Application roles (the database is the only source of permissions).
enum AppRole {
  FARMER
  VOLUNTEER
  ADMIN
  SUPER_ADMIN
}

/// Admin specialisation used by the permission matrix.
enum AdminLevel {
  ADMIN
  AGRONOMIST
  REVIEWER
  ANALYST
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum VolunteerVerification {
  PENDING
  VERIFIED
  SUSPENDED
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum DiagnosisStatus {
  COMPLETED
  FAILED
}

enum ReviewStatus {
  UNREVIEWED
  PENDING
  CONFIRMED
  CHALLENGED
  NEEDS_INFO
}

enum ReviewVerdict {
  CONFIRMED
  CHALLENGED
  NEEDS_INFO
}

enum KnowledgeStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  role         AppRole
  assignedAt   DateTime @default(now())
  assignedById String?

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleGrantor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// Invitation for a phone number to receive VOLUNTEER or ADMIN on verified sign-in.
model RoleInvitation {
  id             String           @id @default(cuid())
  phone          String
  role           AppRole
  adminLevel     AdminLevel?
  serviceArea    String?
  invitedById    String
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  createdAt      DateTime         @default(now())

  invitedBy User @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([phone, status])
  @@map("role_invitations")
}

model VolunteerProfile {
  userId             String                @id
  serviceArea        String?
  district           String?
  state              String?
  languages          String[]              @default([])
  verificationStatus VolunteerVerification @default(PENDING)
  trainingStatus     TrainingStatus        @default(NOT_STARTED)
  profileCompletedAt DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("volunteer_profiles")
}

model AdminProfile {
  userId      String     @id
  adminLevel  AdminLevel @default(ADMIN)
  permissions String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model FarmerProfile {
  userId                   String    @id
  preferredName            String?
  language                 String    @default("hi")
  state                    String?
  district                 String?
  village                  String?
  mainCrops                String[]  @default([])
  farmSizeAcres            Decimal?  @db.Decimal(10, 2)
  voiceEnabled             Boolean   @default(true)
  /// Consent to keep uploaded photos for history and expert review.
  photoConsentAt           DateTime?
  /// Consent to save Mitra text-chat history (null = not saved / withdrawn).
  chatHistoryConsentAt     DateTime?
  /// Consent to save Mitra voice TRANSCRIPTS as conversation history (audio is never recorded).
  voiceTranscriptConsentAt DateTime?
  /// Privacy-policy version the farmer last consented under, e.g. "2026-11-13".
  consentPolicyVersion     String?
  onboardedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("farmer_profiles")
}

model Farm {
  id            String   @id @default(cuid())
  ownerId       String
  name          String   @default("My farm")
  latitude      Float?
  longitude     Float?
  locationLabel String?
  areaAcres     Decimal? @db.Decimal(10, 2)
  isPrimary     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cropRecords CropRecord[]
  diagnoses   Diagnosis[]
  weather     WeatherObservation[]

  @@index([ownerId])
  @@map("farms")
}

/// A crop grown on a farm; created the first time a farmer checks that crop.
model CropRecord {
  id        String   @id @default(cuid())
  farmId    String
  crop      String
  createdAt DateTime @default(now())

  farm      Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  diagnoses Diagnosis[]

  @@unique([farmId, crop])
  @@map("crop_records")
}

model Diagnosis {
  id           String          @id @default(cuid())
  farmerId     String
  farmId       String?
  cropRecordId String?
  selectedCrop String?
  status       DiagnosisStatus @default(COMPLETED)

  // image (private storage; see PlatformSetting image_retention_days)
  imageKey         String?
  imageSha256      String?
  imageMime        String?
  imageBytes       Int?
  imageWidth       Int?
  imageHeight      Int?
  originalFilename String?
  imageExpiresAt   DateTime?

  // model output, exactly as returned by the inference service
  modelName          String
  modelVersion       String
  modelSha256        String
  predictedLabel     String
  predictedCrop      String
  predictedCondition String
  isHealthy          Boolean
  confidence         Float
  margin             Float
  globalTopLabel     String?
  globalTopScore     Float?
  scoreType          String
  inferenceMs        Int
  latencyMs          Int
  qualityStatus      String
  qualityWarnings    Json    @default("[]")
  advisories         Json    @default("[]")
  rawOutput          Json

  // derived context
  weatherObservationId String?
  knowledgeEntryId     String?
  explanation          Json?
  explanationSource    String? // "llm" | "approved_guidance" | "none"
  explanationLanguage  String?

  reviewStatus      ReviewStatus @default(UNREVIEWED)
  reviewRequestedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  farmer        User                    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm          Farm?                   @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cropRecord    CropRecord?             @relation(fields: [cropRecordId], references: [id], onDelete: SetNull)
  weather       WeatherObservation?     @relation(fields: [weatherObservationId], references: [id], onDelete: SetNull)
  knowledge     KnowledgeEntry?         @relation(fields: [knowledgeEntryId], references: [id], onDelete: SetNull)
  predictions   ModelPrediction[]
  reviews       ExpertReview[]
  conversations ConversationDiagnosis[]
  feedback      DiagnosisFeedback[]

  @@index([farmerId, createdAt])
  @@index([createdAt])
  @@index([predictedCrop])
  @@index([predictedLabel])
  @@index([reviewStatus, createdAt])
  @@map("diagnoses")
}

/// Normalised top-k output (one row per ranked class) for querying and analytics.
model ModelPrediction {
  id          String  @id @default(cuid())
  diagnosisId String
  rank        Int
  label       String
  crop        String
  condition   String
  score       Float
  rawScore    Float
  isHealthy   Boolean

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@unique([diagnosisId, rank])
  @@index([label])
  @@map("model_predictions")
}

/// Expert conclusions are stored separately; the original model output is never changed.
model ExpertReview {
  id             String        @id @default(cuid())
  diagnosisId    String
  reviewerId     String
  verdict        ReviewVerdict
  correctedLabel String?
  note           String
  createdAt      DateTime      @default(now())

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  reviewer  User      @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([diagnosisId, createdAt])
  @@map("expert_reviews")
}

model DiagnosisFeedback {
  id          String   @id @default(cuid())
  diagnosisId String
  farmerId    String
  helpful     Boolean
  comment     String?
  createdAt   DateTime @default(now())

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  farmer    User      @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@unique([diagnosisId, farmerId])
  @@map("diagnosis_feedback")
}

/// Agricultural guidance. Only APPROVED entries reach farmers.
model KnowledgeEntry {
  id                   String          @id @default(cuid())
  crop                 String
  /// Checkpoint label, e.g. "tomato::Late blight".
  conditionLabel       String
  title                String
  summary              String
  symptoms             String[]        @default([])
  causes               String[]        @default([])
  inspectionSteps      String[]        @default([])
  prevention           String[]        @default([])
  /// Only locally approved treatment guidance; may be empty.
  approvedTreatment    String[]        @default([])
  furtherTesting       String[]        @default([])
  regions              String[]        @default([])
  sourceUrl            String?
  sourceOrganisation   String?
  referenceImageKey    String?
  referenceImageCredit String?
  status               KnowledgeStatus @default(DRAFT)
  reviewNote           String?
  createdById          String
  reviewedById         String?
  reviewedAt           DateTime?
  lastReviewedAt       DateTime?
  version              Int             @default(1)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  createdBy  User        @relation("KnowledgeAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?       @relation("KnowledgeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  diagnoses  Diagnosis[]

  @@index([conditionLabel, status])
  @@index([crop, status])
  @@map("knowledge_entries")
}

model WeatherObservation {
  id              String   @id @default(cuid())
  farmId          String?
  latitude        Float
  longitude       Float
  provider        String   @default("open-meteo")
  observedAt      DateTime
  temperatureC    Float?
  humidityPct     Float?
  precipitationMm Float?
  rainLast24hMm   Float?
  rainLast72hMm   Float?
  forecast        Json?
  fetchedAt       DateTime @default(now())

  farm      Farm?       @relation(fields: [farmId], references: [id], onDelete: SetNull)
  diagnoses Diagnosis[]

  @@index([farmId, observedAt])
  @@map("weather_observations")
}

model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// --- Notifications Model ---

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  channel   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  metadata  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// --- Audit Log Model ---

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  resource   String
  resourceId String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// --- Idempotency Model ---

model IdempotencyKey {
  key       String   @id
  status    String // 'processing', 'completed', 'failed'
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("idempotency_keys")
}

// --- Jobs and Scheduling Models ---

model Job {
  id          String    @id @default(cuid())
  name        String
  payload     Json?
  status      String // 'queued', 'running', 'completed', 'failed', 'retrying', 'cancelled'
  attempts    Int       @default(0)
  maxRetries  Int       @default(3)
  error       String?
  runAt       DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@map("jobs")
}

model ScheduledJob {
  id             String    @id @default(cuid())
  name           String
  payload        Json?
  cronExpression String?
  intervalMs     Int?
  nextRunAt      DateTime
  lastRunAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, nextRunAt])
  @@map("scheduled_jobs")
}

model DeviceRegistration {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String
  platform  String // 'ios', 'android', 'web'
  token     String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("device_registrations")
}

// --- AI Core Models ---

model Conversation {
  id                  String    @id @default(cuid())
  userId              String?
  /// text | voice | mixed (Mitra) | agent. A Mitra conversation continues across text and voice.
  channel             String    @default("text")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  metadata            Json?
  /// Mitra fields
  title               String?
  language            String?
  status              String    @default("active") // active | archived
  /// true when messages are stored (farmer consented); otherwise only a short-lived cache exists
  persisted           Boolean   @default(false)
  /// rolling summary of older turns (context compression, not a substitute for diagnosis records)
  summary             String?
  summaryVersion      Int       @default(0)
  summarizedMessageId String?
  lastMessageAt       DateTime?

  messages  Message[]
  diagnoses ConversationDiagnosis[]
  user      User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastMessageAt])
  @@map("conversations")
}

/// Crop checks discussed in a conversation (the verified link Mitra uses to find "my report").
model ConversationDiagnosis {
  conversationId String
  diagnosisId    String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  diagnosis    Diagnosis    @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@id([conversationId, diagnosisId])
  @@index([diagnosisId])
  @@map("conversation_diagnoses")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user, assistant, tool (system prompts are never stored)
  content        String
  createdAt      DateTime @default(now())
  sequence       Int      @default(0)
  metadata       Json?
  /// text | voice_transcript | tool_result
  modality       String   @default("text")
  /// complete | failed | interrupted
  status         String   @default("complete")
  provider       String?
  model          String?
  /// client/Vapi turn id — makes repeated events idempotent
  turnId         String?  @unique

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sequence])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Memory {
  id         String    @id @default(cuid())
  userId     String
  content    String
  sourceId   String? // e.g., conversationId
  importance Int       @default(0)
  expiresAt  DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memories")
}

// --- RAG / Document Models ---

model Document {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  filename       String
  mimeType       String
  source         String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chunks DocumentChunk[]
  user   User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model DocumentChunk {
  id         String @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int
  metadata   Json?

  // Note: Adjust the vector dimension based on your embedding model (e.g., 1536 for OpenAI)
  embedding Unsupported("vector(1536)")?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}
