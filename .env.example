# =============================================================================
# Fullstack Hackathon Template - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets.
# =============================================================================

# --- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon_db?schema=public"

# --- Redis (optional) --------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth Provider ------------------------------------------------------------
# AUTH_PROVIDER=credentials  # credentials | clerk | nextauth | supabase
# AUTH_SECRET=your-auth-secret-here

# --- Storage Provider ---------------------------------------------------------
# STORAGE_PROVIDER=local  # local | s3 | cloudinary | supabase
# STORAGE_BUCKET=uploads
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=

# --- Email Provider -----------------------------------------------------------
# EMAIL_PROVIDER=mailpit  # mailpit | resend | sendgrid | ses
# EMAIL_FROM=noreply@example.com
# MAILPIT_SMTP_HOST=localhost
# MAILPIT_SMTP_PORT=1025
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# --- OTP ----------------------------------------------------------------------
# OTP_MODE=mock  # mock | real
# OTP_EXPIRY_SECONDS=300
# OTP_MAX_ATTEMPTS=5

# --- Payment Provider ---------------------------------------------------------
# PAYMENT_PROVIDER=mock  # mock | razorpay | stripe
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- AI Provider --------------------------------------------------------------
# AI_PROVIDER=openai  # openai | anthropic | google | mock
# AI_MODEL=gpt-4o-mini
# AI_MAX_STEPS=10
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- AI Observability ---------------------------------------------------------
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

# --- Voice & Realtime ---------------------------------------------------------
NEXT_PUBLIC_VOICE_MODE=mock # mock | vapi
NEXT_PUBLIC_VOICE_MODEL=gpt-4o-mini
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
VAPI_API_KEY=
MINIMAX_API_KEY=

# --- Feature Flags ------------------------------------------------------------
FEATURE_AUTH=true
FEATURE_VOICE=false
FEATURE_OTP=false
FEATURE_EMAIL=false
FEATURE_STORAGE=false
FEATURE_PAYMENTS=false
FEATURE_REDIS=false
FEATURE_AI=false
FEATURE_RAG=false
FEATURE_AGENTS=false
FEATURE_MCP=false
FEATURE_ANALYTICS=false
FEATURE_DEMO_MODE=true

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Hackathon App"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- AgriSmart inference service (server-only; NEVER prefix with NEXT_PUBLIC_) ---
# AI_INFERENCE_BASE_URL=http://127.0.0.1:8001
# AI_SERVICE_TOKEN=            # 32+ random chars, same value as ai/services/inference/.env
# AI_INFERENCE_TIMEOUT_MS=65000
# ENABLE_DEV_TOOLS=false       # true exposes /dev/model-lab in production builds

# --- CropAI platform -----------------------------------------------------------
# Auth: our own phone + OTP login for every role (no email, no password, no social login).
# AUTH_OTP_PROVIDER=dev        # dev = free local mode: no SMS, localhost only, refused in production
#                              # twilio_verify = real SMS through Twilio Verify
# AUTH_DEV_OTP_CODE=424242     # dev mode code (6 digits). Put dev settings in .env.development.local
# AUTH_DEV_OTP_PHONES=         # optional comma list of E.164 numbers allowed in dev mode
# TWILIO_ACCOUNT_SID=          # AC... (server-only — never NEXT_PUBLIC_)
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=   # VA... (Twilio Console -> Verify -> Services)
# AUTH_SECRET=                 # 32+ random chars (keys OTP rate-limit counters, signed voice tokens)
# AUTH_OWNER_PHONES=          # optional owner/developer E.164 numbers: SUPER_ADMIN + FARMER + VOLUNTEER (keep empty in production)
# APP_PUBLIC_URL=http://localhost:3000   # https public URL enables Vapi tool webhooks
# PRIVATE_STORAGE_DIR=         # default ./storage/private (git-ignored)
# NEXT_PUBLIC_BRAND_NAME=CropAI
# NEXT_PUBLIC_ASSISTANT_NAME=Mitra
# NEXT_PUBLIC_CONTACT_EMAIL=
# FEATURE_AUDIT_LOGS=true
# FEATURE_NOTIFICATIONS=true
# FEATURE_REDIS=true

# LLM for Mitra's text chat + report explanations (LangChain). Unset = Mitra says "not configured"
# (no canned answers). Choose ONE:
#   openai-compatible (tool calling): OpenAI, or free tiers such as
#     Google Gemini  GENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  GENAI_MODEL=gemini-2.5-flash
#     Groq           GENAI_BASE_URL=https://api.groq.com/openai/v1                           GENAI_MODEL=llama-3.3-70b-versatile
#   vapi: Vapi Chat API with VAPI_API_KEY (needs a payment method on the Vapi account); GENAI_MODEL defaults to gpt-4o-mini
# GENAI_PROVIDER=openai-compatible
# GENAI_API_KEY=
# GENAI_MODEL=
# GENAI_BASE_URL=https://api.openai.com/v1

# Vapi voice (server key never NEXT_PUBLIC). Webhook secret is sent by Vapi to /api/v1/voice/tools.
# VAPI_WEBHOOK_SECRET=
# VAPI_LLM_MODEL=gpt-4o-mini

# TinyFish web search/fetch for knowledge-base source discovery (NOT the LLM).
# TINYFISH_API_KEY=

# LangSmith tracing (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=cropai
