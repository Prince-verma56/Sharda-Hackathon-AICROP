# =============================================================================
# Fullstack Hackathon Template - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets.
# =============================================================================

# --- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon_db?schema=public"

# --- Redis (optional) --------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth Provider ------------------------------------------------------------
# AUTH_PROVIDER=credentials  # credentials | clerk | nextauth | supabase
# AUTH_SECRET=your-auth-secret-here

# --- Storage Provider ---------------------------------------------------------
# STORAGE_PROVIDER=local  # local | s3 | cloudinary | supabase
# STORAGE_BUCKET=uploads
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=

# --- Email Provider -----------------------------------------------------------
# EMAIL_PROVIDER=mailpit  # mailpit | resend | sendgrid | ses
# EMAIL_FROM=noreply@example.com
# MAILPIT_SMTP_HOST=localhost
# MAILPIT_SMTP_PORT=1025
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# --- OTP ----------------------------------------------------------------------
# OTP_MODE=mock  # mock | real
# OTP_EXPIRY_SECONDS=300
# OTP_MAX_ATTEMPTS=5

# --- Payment Provider ---------------------------------------------------------
# PAYMENT_PROVIDER=mock  # mock | razorpay | stripe
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- AI Provider --------------------------------------------------------------
# AI_PROVIDER=openai  # openai | anthropic | google | mock
# AI_MODEL=gpt-4o-mini
# AI_MAX_STEPS=10
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- AI Observability ---------------------------------------------------------
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

# --- Voice & Realtime ---------------------------------------------------------
NEXT_PUBLIC_VOICE_MODE=mock # mock | vapi
NEXT_PUBLIC_VOICE_MODEL=gpt-4o-mini
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
VAPI_API_KEY=
MINIMAX_API_KEY=

# --- Feature Flags ------------------------------------------------------------
FEATURE_AUTH=true
FEATURE_VOICE=false
FEATURE_OTP=false
FEATURE_EMAIL=false
FEATURE_STORAGE=false
FEATURE_PAYMENTS=false
FEATURE_REDIS=false
FEATURE_AI=false
FEATURE_RAG=false
FEATURE_AGENTS=false
FEATURE_MCP=false
FEATURE_ANALYTICS=false
FEATURE_DEMO_MODE=true

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Hackathon App"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- AgriSmart inference service (server-only; NEVER prefix with NEXT_PUBLIC_) ---
# AI_INFERENCE_BASE_URL=http://127.0.0.1:8001
# AI_SERVICE_TOKEN=            # 32+ random chars, same value as ai/services/inference/.env
# AI_INFERENCE_TIMEOUT_MS=65000
# ENABLE_DEV_TOOLS=false       # true exposes /dev/model-lab in production builds

# --- CropAI platform -----------------------------------------------------------
# Auth: our own phone + OTP login for every role (no email, no password, no social login).
# AUTH_OTP_PROVIDER=dev        # dev = free local mode: no SMS, localhost only, refused in production
#                              # twilio_verify = real SMS through Twilio Verify
# AUTH_DEV_OTP_CODE=424242     # dev mode code (6 digits). Put dev settings in .env.development.local
# AUTH_DEV_OTP_PHONES=         # optional comma list of E.164 numbers allowed in dev mode
# TWILIO_ACCOUNT_SID=          # AC... (server-only — never NEXT_PUBLIC_)
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=   # VA... (Twilio Console -> Verify -> Services)
# AUTH_SECRET=                 # 32+ random chars (keys OTP rate-limit counters, signed voice tokens)
# AUTH_OWNER_PHONES=          # optional owner/developer E.164 numbers: SUPER_ADMIN + FARMER + VOLUNTEER (keep empty in production)
# APP_PUBLIC_URL=http://localhost:3000   # https public URL enables Vapi tool webhooks
# PRIVATE_STORAGE_DIR=         # default ./storage/private (git-ignored)
# NEXT_PUBLIC_BRAND_NAME=CropAI
# NEXT_PUBLIC_ASSISTANT_NAME=Mitra
# NEXT_PUBLIC_CONTACT_EMAIL=
# FEATURE_AUDIT_LOGS=true
# FEATURE_NOTIFICATIONS=true
# FEATURE_REDIS=true

# LLM for Mitra's text chat + report explanations (LangChain). Unset = Mitra says "not configured"
# (no canned answers). Choose ONE:
#   openai-compatible (tool calling): OpenAI, or free tiers such as
#     Google Gemini  GENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  GENAI_MODEL=gemini-2.5-flash
#     Groq           GENAI_BASE_URL=https://api.groq.com/openai/v1                           GENAI_MODEL=llama-3.3-70b-versatile
#   vapi: Vapi Chat API with VAPI_API_KEY (needs a payment method on the Vapi account); GENAI_MODEL defaults to gpt-4o-mini
# GENAI_PROVIDER=openai-compatible
# GENAI_API_KEY=
# GENAI_MODEL=
# GENAI_BASE_URL=https://api.openai.com/v1

# Vapi voice (server key never NEXT_PUBLIC). Webhook secret is sent by Vapi to /api/v1/voice/tools.
# VAPI_WEBHOOK_SECRET=
# VAPI_LLM_MODEL=gpt-4o-mini

# TinyFish web search/fetch for knowledge-base source discovery (NOT the LLM).
# TINYFISH_API_KEY=

# LangSmith tracing (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=cropai

# =============================================================================
# Additional variables referenced by the code (placeholders only, never real values)
# See docs/final-release/VERCEL_ENV_VARIABLES.md (local) for purpose and environment.
# =============================================================================

# --- AgriSmart inference service: set on the INFERENCE HOST, not on Vercel ----
# AGRISMART_MODEL_DIR=/opt/agrismart/model        # model package folder (predict.py, weights.json)
# AGRISMART_MODEL_PATH=/models/model.pt           # 344 MB checkpoint path (mount it, never commit it)
# AI_INFERENCE_DEVICE=cpu                         # auto | cpu | cuda
# AI_INFERENCE_THREADS=4                          # torch CPU threads (1-16)
# AI_INFERENCE_TIMEOUT_SECONDS=60                 # per-prediction timeout inside the service
# AI_INFERENCE_MAX_IN_FLIGHT=2                    # concurrent requests before HTTP 429
# AI_INFERENCE_ENABLE_DOCS=false                  # Swagger /docs; keep false on any public host
# AI_INFERENCE_LOG_LEVEL=INFO                     # service log level
# AI_INFERENCE_PORT=8001                          # local only: loopback port in docker/compose.ai.yaml
# AGRISMART_SAMPLES_DIR=                          # local only: sample photos folder (default ai/models/agrismart-india/upstream/samples)

# --- Local Docker (docker/compose.dev.yaml) - local development only -----------
# POSTGRES_PORT=5432                              # host port for PostgreSQL (change if 5432 is taken)
# POSTGRES_USER=postgres                          # local database user
# POSTGRES_PASSWORD=postgres                      # local database password (compose default)
# POSTGRES_DB=hackathon_db                        # local database name
# REDIS_PORT=6379                                 # host port for Redis (change if 6379 is taken)
# ADMINER_PORT=8080                               # Adminer UI (loopback only)
# REDISINSIGHT_PORT=5540                          # RedisInsight UI (loopback only)
# MAILPIT_HTTP_PORT=8025                          # Mailpit web UI
# PGADMIN_EMAIL=admin@example.com                 # pgAdmin login (local only)
# PGADMIN_PASSWORD=change-me                      # pgAdmin password (local only)
# PGADMIN_PORT=5050                               # pgAdmin UI port

# --- Proposed self-hosted production compose (docker/compose.crop.*.example.yaml)
# CROP_WEB_IMAGE=registry.example.com/cropai-web:tag            # reviewed immutable web image
# CROP_INFERENCE_IMAGE=registry.example.com/cropai-inference:tag # reviewed immutable inference image
# REDIS_PASSWORD=                                 # Redis password for the self-hosted stack

# --- Optional integrations (template services) --------------------------------
# GOOGLE_MAPS_API_KEY=                            # server-only; template location provider (FEATURE_LOCATION)
# PUSH_MODE=mock                                  # template push notification mode
# LANGCHAIN_API_KEY=                              # legacy alias of LANGSMITH_API_KEY (server-only)

# --- More feature flags (config/features.ts; true | false) ---------------------
# FEATURE_PRELOADER=true                          # intro preloader animation
# FEATURE_REALTIME=false                          # template SSE realtime
# FEATURE_JOBS=false                              # template background jobs
# FEATURE_SCHEDULER=false                         # template scheduler
# FEATURE_SEARCH=false                            # template search provider
# FEATURE_INTEGRATIONS=false                      # template integrations (declared only)
# FEATURE_WEBHOOKS=false                          # template webhooks (declared only)
# FEATURE_FILE_PROCESSING=false                   # template file pipeline (declared only)
# FEATURE_IMPORT_EXPORT=false                     # template import/export (declared only)
# FEATURE_LOCATION=false                          # template location provider
# FEATURE_MULTIMODAL_AI=false                     # declared only
# FEATURE_PUSH_NOTIFICATIONS=false                # template push notifications

# --- Hackathon scaffolding CLI (scripts/hackathon.ts) - local only -------------
# AI_ORCHESTRATOR_PROVIDER=                       # enables AI mode of the scaffolding CLI
# AI_ORCHESTRATOR_KEY=                            # API key for the scaffolding CLI (fallback for OPENAI_API_KEY)
# DRY_RUN=true                                    # preview scaffolding changes without writing files

# --- Private file storage (photos, volunteer videos) -----------------------------
# local = ./storage/private (development, single server). On Vercel use s3: its disk is not persistent.
# STORAGE_DRIVER=local                            # local | s3
# S3_BUCKET=                                      # private bucket name (AWS S3, Cloudflare R2, MinIO)
# S3_REGION=auto                                  # "auto" for Cloudflare R2, e.g. ap-south-1 for AWS
# S3_ENDPOINT=                                    # R2: https://<account-id>.r2.cloudflarestorage.com (empty for AWS)
# S3_ACCESS_KEY_ID=                               # server-only access key with read/write on the bucket
# S3_SECRET_ACCESS_KEY=                           # server-only secret (never NEXT_PUBLIC_)
# S3_FORCE_PATH_STYLE=false                       # true for MinIO
# VOLUNTEER_VIDEO_MAX_MB=60                       # set 4 on Vercel (4.5 MB request-body limit) until direct uploads exist

# --- Vapi server tools (optional) -------------------------------------------------
# Create a Vapi credential (Bearer token = VAPI_WEBHOOK_SECRET) in the Vapi dashboard and put its id here.
# Tools turn on only with an https APP_PUBLIC_URL + VAPI_WEBHOOK_SECRET (24+ chars) + this id; the secret
# itself is never sent to browsers.
# VAPI_TOOLS_CREDENTIAL_ID=
