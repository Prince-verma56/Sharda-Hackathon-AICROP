<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts (until Flutter draws its first frame). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/crop_green_950</item>
    </style>
    <!-- Window behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/crop_cream</item>
    </style>
</resources>
