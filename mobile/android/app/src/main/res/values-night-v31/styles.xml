<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen: brand colour + leaf, then the Flutter splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/crop_green_950</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/crop_green_950</item>
        <item name="android:statusBarColor">@color/crop_green_950</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/crop_cream</item>
    </style>
</resources>
